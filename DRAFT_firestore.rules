rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net - Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Common global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admin authorization mapping
    // Checked if the logged user is linked in users/admin setup
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/admin) && 
             get(/databases/$(database)/documents/users/admin).data.uid == request.auth.uid;
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      // Any signed in client session can get user credentials block to authenticate
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidUser(incoming());
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['uid']) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    function isValidUser(data) {
      return data.u is string && data.u.size() >= 1 && data.u.size() <= 100 &&
             data.p is string && data.p.size() >= 1 && data.p.size() <= 100 &&
             data.role is string && (data.role == 'admin' || data.role == 'user');
    }

    // --- Questions Collection Rules ---
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidQuestion(incoming());
      allow update: if isAdmin() && isValidQuestion(incoming());
      allow delete: if isAdmin();
    }

    function isValidQuestion(data) {
      return data.t is string && data.t.size() > 0 && data.t.size() <= 200 &&
             data.q is string && data.q.size() > 0 && data.q.size() <= 2000 &&
             data.o is list && data.o.size() == 4 &&
             data.a is int && data.a >= 0 && data.a <= 3;
    }

    // --- Configs Collection Rules ---
    match /configs/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidConfig(incoming());
      allow delete: if isAdmin();
    }

    function isValidConfig(data) {
      return data.qty is int && data.qty > 0 && data.qty <= 500 &&
             data.time is int && data.time > 0 && data.time <= 1440;
    }

    // --- Exam Results Collection Rules ---
    match /results/{resultId} {
      // Allows reading results for stats if admin, or if this result matches the student of this transaction
      allow read: if isSignedIn() && (isAdmin() || existing().user == request.auth.uid || existing().user == resultId);
      allow create: if isSignedIn() && isValidResult(incoming());
      allow update, delete: if isAdmin();
    }

    function isValidResult(data) {
      return data.user is string && data.user.size() > 0 && data.user.size() <= 100 &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             data.correctCount is int && data.correctCount >= 0 &&
             data.totalQuestions is int && data.totalQuestions > 0 &&
             data.secondsTaken is int && data.secondsTaken >= 0 &&
             data.createdAt is timestamp;
    }

  }
}
